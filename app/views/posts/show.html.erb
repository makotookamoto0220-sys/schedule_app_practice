<h1>予定の詳細</h1>

<table>
  <tr>
     <th>タイトル</th>
     <td><%= @post.title %></td>
  </tr>

  <tr>
    <th>開始日</th>
    <td><%= @post.start_date.strftime("%Y/%m/%d") %></td>
  </tr>

   <tr>
    <th>終了日</th>
    <td><%= @post.end_date.strftime("%Y/%m/%d") %></td>
  </tr>

   <tr>
    <th>終日</th>
    <td><%= @post.all_day ? "○" : "" %></td>
  </tr>

   <tr>
    <th>スケジュールメモ</th>
    <td><%= @post.body %></td>
  </tr>

</table>

<%= link_to("編集", edit_post_path(@post)) %>
<%= link_to("一覧", posts_path)%>